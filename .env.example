# Database
DATABASE_URL=sqlite:///./echo_mcp.db

# Security
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
ALLOWED_HOSTS=["*"]

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_ENABLED=true

# Cache TTL Settings (in seconds)
CACHE_TTL_SECONDS=3600
CHAT_CACHE_TTL_SECONDS=300
SESSION_CACHE_TTL_SECONDS=1800
USER_CACHE_TTL_SECONDS=600

# External APIs - Food Service
FOOD_API_BASE_URL=
FOOD_API_KEY=

# External APIs - Ride Service  
RIDE_API_BASE_URL=
RIDE_API_KEY=

# Email settings (for auth)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
